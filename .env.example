# Create an Upstash Redis database and connect it through the Vercel Marketplace.
# These are server-only variables. Never put tokens in public/.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's KV_REST_API_URL / KV_REST_API_TOKEN aliases are also accepted.

# Set a strong, private passphrase to enable the moderation page at /admin.html.
MEMORY_ADMIN_TOKEN=
# Optional: require a class code before visitors can post. Reading stays public.
MEMORY_POST_CODE=
# Optional: hold contributions for approval. Requires MEMORY_ADMIN_TOKEN.
MEMORY_REQUIRE_APPROVAL=false
# Optional explicit public origin, e.g. https://your-site.vercel.app
SITE_ORIGIN=
